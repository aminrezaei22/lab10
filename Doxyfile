# Minimal Doxygen configuration for the arcade project.
# Generate with:  cmake --build build --target docs      (or:  doxygen Doxyfile)
PROJECT_NAME           = "Arcade"
PROJECT_BRIEF          = "COSC 1437 arcade project"
OUTPUT_DIRECTORY       = docs
INPUT                  = src include app
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_ANON_NSPACES   = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO

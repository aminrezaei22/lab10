digraph copy_constructor {
  node [fontname="Helvetica"];
  start [shape=ellipse, label="Deck(const Deck &other)"];
  alloc [shape=box, label="m_cards = new Card[other.m_size]\nm_size = other.m_size\nm_next = other.m_next"];
  init [shape=box, label="i = 0"];
  cond [shape=diamond, label="i < m_size ?"];
  copy [shape=box, label="m_cards[i] = other.m_cards[i]"];
  inc [shape=box, label="i = i + 1"];
  stop [shape=ellipse, label="done"];
  start -> alloc -> init -> cond;
  cond -> copy [label="yes"];
  copy -> inc -> cond;
  cond -> stop [label="no"];
}
